# All settings are optional; the values shown are the defaults. No secrets are needed:
# the Elexon BMRS Insights API is public and requires no key.

# Analysis window (local UK delivery dates, inclusive)
DELIVERY_START=2026-01-01
DELIVERY_END=2026-01-31
ANALYSIS_TIMEZONE=Europe/London

# Purchase-decision cutoff: DECISION_CUTOFF_LOCAL on DECISION_CUTOFF_DAYS_BEFORE days before delivery
DECISION_CUTOFF_LOCAL=11:00
DECISION_CUTOFF_DAYS_BEFORE=1
DECISION_CUTOFF_INCLUSIVE=true

# MAPE excludes hours whose actual generation is below this (MW)
MAPE_MIN_ACTUAL_MW=1

# auto = live Elexon, falling back to the bundled snapshot; live = live only; snapshot = bundled file only
DATA_SOURCE=auto
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_CONCURRENCY=6

# Comma-separated origins allowed to call the API (not needed when frontend and API share an origin)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (build time): API base URL; leave empty to call the same origin
VITE_API_BASE_URL=
